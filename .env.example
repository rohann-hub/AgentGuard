# Copy to .env and change the values. Never commit .env.
AGENTGUARD_ENV=development
AGENTGUARD_LOG_LEVEL=INFO

POSTGRES_DB=agentguard
POSTGRES_USER=agentguard
POSTGRES_PASSWORD=change-me

# Used when running the app outside Docker. Inside Compose these are set for you.
AGENTGUARD_DATABASE_URL=postgresql+psycopg://agentguard:change-me@localhost:5432/agentguard
AGENTGUARD_OPA_URL=http://localhost:8181

# Agents allowed to call the proxy: JSON of agent name -> SHA-256 hex of its API key.
# Empty means every proxy request is rejected. Generate a key and its hash with:
#   python -c "import secrets,hashlib;k=secrets.token_urlsafe(32);print(k, hashlib.sha256(k.encode()).hexdigest())"
AGENTGUARD_AGENT_API_KEYS={}
